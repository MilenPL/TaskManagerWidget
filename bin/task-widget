#!/usr/bin/env python3
"""Start the task manager widget (works from a checkout, no install needed)."""
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if ROOT not in sys.path:
    sys.path.insert(0, ROOT)

from taskwidget.launcher import widget  # noqa: E402

if __name__ == "__main__":
    widget()
