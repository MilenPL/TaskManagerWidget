#!/usr/bin/env python3
"""Start 'task manager widget settings' (works from a checkout)."""
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if ROOT not in sys.path:
    sys.path.insert(0, ROOT)

from taskwidget.launcher import settings  # noqa: E402

if __name__ == "__main__":
    settings()
